    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst items = response.items ?? [];\n\nif (items.length === 0) {\n  return [{\n    json: {\n      merchant_id: response.merchant_id,\n      has_rows: false,\n      synced_at: response.as_of\n    }\n  }];\n}\n\nreturn items.map(item => ({\n  json: {\n    merchant_id: response.merchant_id,\n    sku: String(item.sku).toUpperCase(),\n    qty: Number(item.qty),\n    synced_at: response.as_of,\n    has_rows: true\n  }\n}));"
      },
