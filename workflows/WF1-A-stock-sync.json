        "operation": "executeQuery",
        "query": "INSERT INTO ops.sync_runs (\n    merchants_total,\n    merchants_ok,\n    rows_synced,\n    new_stockouts,\n    duration_ms\n)\nSELECT\n    (SELECT COUNT(*)\n     FROM core.merchants\n     WHERE active = true),\n\n    COUNT(DISTINCT merchant_id),\n\n    COUNT(*),\n\n    0,\n\n    (EXTRACT(EPOCH FROM (\n        NOW() - '{{ $('Schedule Trigger').first().json.timestamp }}'::timestamptz\n    )) * 1000)::integer\n\nFROM core.merchant_stock\nWHERE synced_at >= '{{ $('Schedule Trigger').first().json.timestamp }}'::timestamptz\n\nRETURNING *;",
        "options": {}
